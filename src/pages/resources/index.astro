---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const resources = await getCollection('resources');
---

<BaseLayout
  title="Resources"
  description="Vetted local resources for fathers and families in Kitsap County."
>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl font-extrabold tracking-tight">Resources</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-slate-800">
      A short, vetted list of local help — housing, jobs, parenting support, and
      family activities. Entries below are placeholders while we verify descriptions
      and links for relaunch.
    </p>

    {
      resources.length === 0 ? (
        <p class="mt-6 leading-relaxed text-slate-800">
          No resources are posted yet — check back soon.
        </p>
      ) : (
        <ul class="mt-6 grid gap-5 sm:grid-cols-2">
          {resources.map((resource) => (
            <li class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
              <h2 class="text-lg font-bold">{resource.data.title}</h2>
              {resource.data.description && (
                <p class="mt-2 leading-relaxed text-slate-800">{resource.data.description}</p>
              )}
              {resource.data.category && (
                <p class="mt-3 text-[0.95rem] text-slate-800">
                  <span class="font-semibold">Type:</span> {resource.data.category}
                </p>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
