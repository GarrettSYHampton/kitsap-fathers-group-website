---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SUPPORT_BUTTON_LABEL,
  SPONSOR_DISCLOSURE,
  FISCAL_SPONSOR_DONATE_URL,
} from '../consts';

const sponsorLinkReady = FISCAL_SPONSOR_DONATE_URL.length > 0;
---

<BaseLayout
  title="Support"
  description="Support Kitsap Fathers Group through our fiscal sponsor."
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl font-extrabold tracking-tight">Support</h1>
    <div class="prose-links mt-4 space-y-4 leading-relaxed text-slate-800">
      <p>
        Kitsap Fathers Group is a fiscally sponsored project. Contributions are
        handled by our fiscal sponsor — never sent to us directly.
      </p>

      <div class="rounded-lg border border-slate-200 bg-slate-50 p-5">
        {
          sponsorLinkReady ? (
            <a
              href={FISCAL_SPONSOR_DONATE_URL}
              target="_blank"
              rel="noopener"
              class="inline-block rounded-md bg-brand-800 px-5 py-3 font-bold text-white no-underline hover:bg-brand-900"
            >
              {SUPPORT_BUTTON_LABEL}
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          ) : (
            <>
              <p
                aria-disabled="true"
                class="inline-block cursor-not-allowed rounded-md bg-slate-300 px-5 py-3 font-bold text-slate-700"
              >
                {SUPPORT_BUTTON_LABEL}
              </p>
              <p class="mt-3 text-[0.95rem]">
                The fiscal-sponsor giving link is being confirmed and will appear here
                as soon as it is ready.
              </p>
            </>
          )
        }
        <p class="mt-3 text-sm leading-relaxed">
          <span class="font-semibold">Disclosure:</span> {SPONSOR_DISCLOSURE}
        </p>
      </div>

      <p>
        Prefer to help with time instead of money? See <a href="/volunteer">volunteer micro-roles</a>.
      </p>
    </div>
  </div>
</BaseLayout>
