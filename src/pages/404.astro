---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you asked for could not be found.">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-extrabold tracking-tight">Page not found</h1>
    <p class="prose-links mt-4 leading-relaxed text-slate-800">
      Sorry — that address doesn&apos;t exist here. Try the
      <a href="/">home page</a>, or browse <a href="/events">events</a> and
      <a href="/resources">resources</a>.
    </p>
  </div>
</BaseLayout>
